# ========================================
# Backend - Example Environment File
# ========================================
# 📋 HOW TO USE:
# 1. Copy this file to .env.local for local development
# 2. Fill in your real credentials
# 3. .env.local is gitignored automatically - safe for secrets!
#
# ⚠️  NEVER commit files with real credentials to git!
# ========================================

# =========================
# 🌐 SERVER CONFIGURATION
# =========================
PORT=5001
NODE_ENV=development
USE_FABRIC=false

# =========================
# 🗄️ DATABASE
# =========================
# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/estathub_db"
#
# Hosted PostgreSQL example (Render, Supabase, etc.):
# DATABASE_URL="postgres://user:password@host.render.com:5432/database"
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>"

# =========================
# 🪪 AUTH & SECURITY
# =========================
# Generate a strong random secret (min 32 characters)
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="<your-jwt-secret-min-32-chars>"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS="12"

# =========================
# 🌐 CORS
# =========================
CORS_ORIGIN=http://localhost:5173

# Fabric integration
USE_FABRIC=false
FABRIC_CHANNEL=estathub-channel
FABRIC_CHAINCODE=estathub
FABRIC_MSP=Org1MSP
FABRIC_USER_ID=appUser
FABRIC_PEER=localhost:7051

# Docker-friendly certificate paths (certs mounted into /app/fabric/certs)
FABRIC_TLS_CERT=/app/fabric/certs/peer.pem
FABRIC_IDENTITY_CERT=/app/fabric/certs/user.pem
FABRIC_PRIVATE_KEY=/app/fabric/certs/user.key

FABRIC_DEBUG=false
DEBUG_FABRIC_GATEWAY=false
LOG_LEVEL=info

## Fabric Gateway integration
USE_FABRIC_GATEWAY=
FABRIC_GATEWAY_URL=
FABRIC_GATEWAY_KEY=
FABRIC_GATEWAY_TIMEOUT_MS=
FABRIC_GATEWAY_RETRY_COUNT=
FABRIC_GATEWAY_RETRY_BASE_DELAY_MS=
FABRIC_GATEWAY_CIRCUIT_BREAKER_ENABLED=
FABRIC_GATEWAY_CB_FAILURE_THRESHOLD=
FABRIC_GATEWAY_CB_RESET_TIMEOUT_MS=
GATEWAY_STARTUP_CHECK=
